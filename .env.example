# Root-level environment example. Real values live in untracked .env files or a secret store.
# API (ASP.NET Core configuration keys; use __ as the section separator in environment variables)
ConnectionStrings__Trimme=Host=localhost;Port=5434;Database=trimme;Username=trimme;Password=change_me_locally
Cors__AllowedOrigins__0=http://localhost:3000

# Development seed (Development environment only)
TRIMME_ALLOW_DEV_SEED=false
TRIMME_BOOTSTRAP_ADMIN_EMAIL=
TRIMME_BOOTSTRAP_ADMIN_PASSWORD=

# Identity (production values come from a secret store, never from this file)
# PersonalData__LookupKey: base64, at least 32 bytes; required outside Development/Testing.
PersonalData__LookupKey=
# Email__Smtp__*: required outside Development/Testing.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Security=StartTls
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=no-reply@example.com
Web__PublicBaseUrl=http://localhost:3000

# Integration tests: regenerate the committed OpenAPI contract
TRIMME_UPDATE_OPENAPI=0
