# Copy to infra/.env to override local development defaults. Never commit infra/.env.
TRIMME_DB_NAME=trimme
TRIMME_DB_USER=trimme
TRIMME_DB_PASSWORD=change_me_locally
# Host port for PostgreSQL (5432/5433 are often taken by a local PostgreSQL install).
TRIMME_DB_PORT=5434
TRIMME_API_PORT=8080
TRIMME_API_ENVIRONMENT=Development
TRIMME_WEB_ORIGIN=http://localhost:3000
TRIMME_WEB_PORT=3000
# Development-only preview routes for E2E smoke tests. Never enable in production.
TRIMME_ENABLE_DEV_ROUTES=true
# Development-only bootstrap SuperAdmin created by the one-shot "seed" service (never in production).
TRIMME_BOOTSTRAP_ADMIN_EMAIL=admin@trimme.local
TRIMME_BOOTSTRAP_ADMIN_PASSWORD=change me locally
# Mailpit web UI (local email inbox for password resets and invitations).
TRIMME_MAILPIT_PORT=8025
