{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Trimme": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RequestLimits": {
    "MaxBodyBytes": 1048576
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "RateLimiting": {}
}
